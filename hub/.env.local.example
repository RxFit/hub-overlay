# =============================================================================
# Paperclip AI Orchestration
# =============================================================================

# Cloud Run instance (primary) — use this until api.paperclip.casatrejo.com is mapped
PAPERCLIP_BASE_URL=https://rxfit-paperclip-11747747730.us-central1.run.app
PAPERCLIP_API_KEY=sk_pc_REPLACE_ME

# Paperclip session auth (email/password — used by paperclipSession.ts for server-side calls)
PAPERCLIP_AUTH_EMAIL=REPLACE_ME
PAPERCLIP_AUTH_PASSWORD=REPLACE_ME

# Default Paperclip company ID for admin/superadmin when no explicit project is specified
# MUST point to the CEO workspace — see orchestration/RxFit/agents/ceo/PAPERCLIP_OPS.md
DEFAULT_PAPERCLIP_COMPANY_ID=8f2acc3d-f2dc-4f8c-897e-7c400e91fd85

# Optional: comma-separated company IDs that can NEVER be deleted (protected
# workspaces). Deletion is refused server-side (403 PROTECTED_WORKSPACE). Use
# this to protect additional load-bearing workspaces without a code change —
# e.g. the SEO Agent workspace. The RxFit Enterprise / CEO workspaces and
# DEFAULT_PAPERCLIP_COMPANY_ID are always protected regardless of this list.
# See docs/runbooks/protected-workspaces.md
# PROTECTED_COMPANY_IDS=

# NOTE: api.paperclip.casatrejo.com is pending Cloud Run custom domain mapping.
# Once mapped, switch both values above/below to that cleaner URL.

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# NextAuth
NEXTAUTH_URL=https://hub.casatrejo.com
NEXTAUTH_SECRET=REPLACE_ME_run_openssl_rand_-base64_32

# Superadmin — can assign admin roles across companies
SUPERADMIN_EMAILS=danny@rxfitatx.com

# Business admins — can assign roles up to staff level (comma-separated)
ADMIN_EMAILS=

# Gemini AI (separate key for hub chat — general queries, fast recall)
GEMINI_API_KEY=REPLACE_ME

# Anthropic (Claude Fable 5 — high-reasoning tasks: interview mode, Pre-Cog, skills)
ANTHROPIC_API_KEY=REPLACE_ME

# Exa.AI — web search for external research queries (get key at dashboard.exa.ai)
EXA_API_KEY=REPLACE_ME

# Vertex AI Search (Semantic Brain) — internal Google Workspace search
# GCP project containing the Vertex AI Search engine
VERTEX_GCP_PROJECT=semantic-brain-desktop
# Engine ID from Vertex AI Search console
VERTEX_ENGINE_ID=semanticbrain_1779229063037
# Service account key JSON (minified, single line) — needs Discovery Engine User role
GOOGLE_SERVICE_ACCOUNT_KEY=REPLACE_ME_WITH_MINIFIED_JSON

# Public vars (safe to expose to browser)
NEXT_PUBLIC_PAPERCLIP_URL=https://rxfit-paperclip-11747747730.us-central1.run.app
NEXT_PUBLIC_TENANT_ID=rxfit

# =============================================================================
# Database (REQUIRED for all persistence)
# =============================================================================

# Postgres connection string (Drizzle + pgvector). REQUIRED — every DB-backed
# feature (chat history, runs, KPIs, telemetry, vector store) throws without it.
DATABASE_URL=postgres://user:REPLACE_ME@host:5432/hub

# Optional: direct/public URL used ONLY by drizzle.config.ts for migrations run
# from outside the Cloud SQL socket. Falls back to DATABASE_URL if unset.
DATABASE_PUBLIC_URL=

# =============================================================================
# KPI data sources (OPTIONAL — each source no-ops/returns null if its key is unset)
# =============================================================================

# Google Analytics 4 property ID (numeric) for the GA4 KPI source. Unset → GA4 KPIs skipped.
GA4_PROPERTY_ID=
# Google Search Console site URL for the GSC KPI source. Unset → Search Console KPIs skipped.
GSC_SITE_URL=
# Stripe secret key for the revenue KPI source. Unset → Stripe KPIs skipped.
STRIPE_SECRET_KEY=

# =============================================================================
# Auth / access control
# =============================================================================

# Sign-in allowlist: comma-separated email domains permitted to authenticate.
# Unset → defaults to the domains of SUPERADMIN_EMAILS + ADMIN_EMAILS.
ALLOWED_EMAIL_DOMAINS=

# =============================================================================
# Security tokens / secrets (OPTIONAL)
# =============================================================================

# Shared secret guarding the /api/kpis/sync cron endpoint. Unset → cron auth check
# is effectively open; set this in any deployment exposing the cron route.
CRON_SECRET=REPLACE_ME
# Token that must match Google push-notification channels hitting /api/webhooks/google.
# Unset → the webhook rejects (or cannot verify) inbound Google notifications.
GOOGLE_WEBHOOK_CHANNEL_TOKEN=REPLACE_ME
# Signing secret for quality-gate tokens. Optional — falls back to NEXTAUTH_SECRET.
GATE_TOKEN_SECRET=

# =============================================================================
# Observability (OPTIONAL — telemetry defaults ON in production)
# =============================================================================

# Set to `false` to disable the observability seam entirely. Any other value / unset → ON.
OBSERVABILITY_ENABLED=
# Set to `off` to disable persisting telemetry events to Postgres. Unset → ON in prod.
TELEMETRY_DB_SINK=

# =============================================================================
# Misc runtime tuning (OPTIONAL — all have safe defaults)
# =============================================================================

# Alternate Gemini API key names read as fallbacks for GEMINI_API_KEY in some routes.
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Vertex AI Search data store ID for attachment resolution. Unset → defaults to 'rxfit-gdrive'.
VERTEX_DATA_STORE_ID=
# Google Drive folder ID for meeting transcripts. Unset → falls back to tenant config.
DRIVE_TRANSCRIPTS_FOLDER_ID=
# Pino log level (debug/info/warn/error). Unset → 'debug' in dev, 'info' in prod.
LOG_LEVEL=
# Filesystem base path for skill definitions. Unset → bundled default location.
SKILLS_BASE_PATH=
# Cosine-similarity cutoff for vector search (0-1). Unset → 0.65.
SIMILARITY_THRESHOLD=

