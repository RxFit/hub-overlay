# Copy to .env (same directory; gitignored) and fill in. install.ps1 does the
# copy for you and warns until the secret is set.
HUB_URL=https://hub.casatrejo.com
# Must byte-match the Hub's AGY_WORKER_SECRET (Secret Manager). Generate once:
#   openssl rand -hex 32   (or PowerShell: -join ((1..64) | %% { '{0:x}' -f (Get-Random -Max 16) }))
AGY_WORKER_SECRET=
WORKER_ID=danny-desktop
# Slot policy per the 2026-08-19 concurrency test (PARALLEL_OK): parallel is
# allowed. work slots stay 0 until the panel phase enqueues work_items.
WORKER_CHAT_SLOTS=1
WORKER_WORK_SLOTS=0
