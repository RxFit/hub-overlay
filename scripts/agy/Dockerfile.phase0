# Phase 0 clean-room runner for the agy allotment replay test.
#
# A container is the truest "throwaway Linux box": it has no OS keyring and no
# D-Bus session, which is exactly the Cloud Run condition we need to prove the
# token replays under. node:22-slim matches the Hub's own base image, so a PASS
# here is a PASS in the real deployment target.
#
# BUILD:
#   docker build -f scripts/agy/Dockerfile.phase0 -t agy-phase0 scripts/agy
#
# RUN (mount your token in read-only; it never enters the image):
#   docker run --rm \
#     -v /abs/path/to/antigravity-oauth-token:/token:ro \
#     -e AGY_TOKEN_FILE=/token \
#     agy-phase0
#
# A non-zero exit means FAIL/SETUP — the verdict text says which and why.

FROM node:22-slim

# util-linux gives us `script` (the pty allocator that fixes agy's silent
# non-TTY stdout drop); ca-certificates + curl for the installer; procps for
# a real /dev/pts. Keep it minimal.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl util-linux procps \
 && rm -rf /var/lib/apt/lists/*

# Run as a non-root user with a real HOME so agy's ~/.gemini paths resolve.
RUN useradd --create-home --shell /bin/bash agyuser
USER agyuser
WORKDIR /home/agyuser
ENV HOME=/home/agyuser

# Install agy at build time — PINNED (hardening move 2). The curl|bash
# installer took whatever the release server served that day; the lock file
# names the exact artifact and the IN-REPO sha512 computed from its bytes
# when the pin was set, so a build fails loudly rather than silently absorb a
# new, untested version. Bump deliberately via scripts/agy/update-agy-pin.sh.
# Auto-update stays off so the binary can't rewrite itself between build and run.
ENV AGY_CLI_DISABLE_AUTO_UPDATE=true
COPY --chown=agyuser:agyuser agy-version.lock /tmp/agy-version.lock
RUN . /tmp/agy-version.lock \
 && echo "installing pinned agy ${AGY_VERSION}" \
 && mkdir -p /home/agyuser/.local/bin \
 && curl -fsSL -o /tmp/agy.tar.gz "${AGY_URL}" \
 && echo "${AGY_SHA512}  /tmp/agy.tar.gz" | sha512sum -c - \
 && tar -xzf /tmp/agy.tar.gz -C /tmp antigravity \
 && mv /tmp/antigravity /home/agyuser/.local/bin/agy \
 && chmod +x /home/agyuser/.local/bin/agy \
 && rm -f /tmp/agy.tar.gz /tmp/agy-version.lock \
 && /home/agyuser/.local/bin/agy --version || true
ENV PATH="/home/agyuser/.local/bin:${PATH}"

COPY --chown=agyuser:agyuser phase0-replay-test.sh /home/agyuser/phase0-replay-test.sh
RUN chmod +x /home/agyuser/phase0-replay-test.sh

ENTRYPOINT ["/home/agyuser/phase0-replay-test.sh"]
