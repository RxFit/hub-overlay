{
  "$meta": {
    "version": 1,
    "updatedAt": "2026-05-29T00:00:00.000Z",
    "source": "configure"
  },
  "database": {
    "mode": "postgres"
  },
  "logging": {
    "mode": "file",
    "logDir": "/paperclip/logs"
  },
  "server": {
    "deploymentMode": "authenticated",
    "exposure": "public",
    "bind": "lan",
    "host": "0.0.0.0",
    "port": 3100,
    "allowedHostnames": ["api.paperclip.casatrejo.com", "paperclip-production-4394.up.railway.app"],
    "serveUi": true
  },
  "auth": {
    "baseUrlMode": "explicit",
    "publicBaseUrl": "https://api.paperclip.casatrejo.com",
    "disableSignUp": true
  },
  "telemetry": {
    "enabled": false
  },
  "storage": {
    "provider": "local_disk",
    "localDisk": {
      "baseDir": "/paperclip/data/storage"
    }
  },
  "secrets": {
    "provider": "local_encrypted",
    "strictMode": false,
    "localEncrypted": {
      "keyFilePath": "/paperclip/secrets/master.key"
    }
  }
}
