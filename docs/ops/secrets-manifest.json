        "EXA_API_KEY",
        "GOOGLE_SERVICE_ACCOUNT_KEY",
        "NEXT_PUBLIC_PAPERCLIP_URL",
        "NEXT_PUBLIC_TENANT_ID",
        "DATABASE_URL",
        "GOOGLE_MAPS_API_KEY",
        "NODE_ENV",
        "PORT"
      ],
      "forbidden_keys": [
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "RAILWAY_TOKEN",
        "VERCEL_TOKEN",
        "WP_USER",
        "WP_APP_PASS",
        "GBP_REFRESH_TOKEN",
        "GITHUB_TOKEN",
        "CLOUDFLARE_*"
      ]
    },
    "paperclip": {
      "railway_service": "paperclip",
      "description": "Paperclip AI orchestration backend — agents execute business operations from here",
      "infrastructure_keys": [
