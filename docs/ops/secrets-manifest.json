{
  "$schema": "secrets-manifest-v1",
  "version": 1,
  "updated": "2026-06-06",
  "description": "Source of truth for which Paperclip workspace receives which API keys. Used by bootstrap scripts and key rotation procedures. Keys are stored as Railway service-level env vars on the Paperclip service; this manifest documents the INTENDED per-workspace access scope.",

  "services": {
    "hub": {
      "railway_service": "hub",
      "description": "Next.js front-end shell (hub.casatrejo.com) — UI only, no business logic execution",
      "allowed_keys": [
        "PAPERCLIP_BASE_URL",
        "PAPERCLIP_API_KEY",
        "PAPERCLIP_AUTH_EMAIL",
        "PAPERCLIP_AUTH_PASSWORD",
        "DEFAULT_PAPERCLIP_COMPANY_ID",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "SUPERADMIN_EMAILS",
