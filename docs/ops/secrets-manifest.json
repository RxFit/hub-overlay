  "key_failure_escalation": {
    "error_codes": {
      "KEY_EXPIRED": "Token/key has expired — rotate key and update env var",
      "KEY_RATE_LIMITED": "API quota exhausted — check billing, upgrade plan or wait for reset",
      "KEY_REVOKED": "Key was manually revoked — generate new key and update env var",
      "KEY_INVALID": "Key format/value is incorrect — verify key in provider dashboard",
      "KEY_UNAUTHORIZED": "Key lacks required permissions — update key scopes/permissions",
      "KEY_BILLING_FAILED": "Provider payment method declined — update billing on provider account"
    },
    "escalation_target": "CEO workspace",
    "escalation_priority": "urgent",
    "issue_title_template": "[KEY-FAIL] {ERROR_CODE}: {KEY_NAME} in {WORKSPACE_NAME}",
    "max_retries_before_escalate": 1
  },

  "tenant_isolation_rules": {
    "external_clients_must_provide": [
      "GEMINI_API_KEY (their own GCP project)",
      "STRIPE_SECRET_KEY (their own Stripe account or Stripe Connect sub-account)",
      "GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET (their own OAuth consent screen)"
    ],
    "never_share_with_external": [
      "STRIPE_SECRET_KEY (owner account)",
      "GBP_* (owner Google Business Profile)",
      "WP_* (owner WordPress admin)",
      "GITHUB_TOKEN (owner personal token)",
      "GOOGLE_SERVICE_ACCOUNT_JSON (owner GCP service account)",
      "RAILWAY_TOKEN",
      "VERCEL_TOKEN",
      "CLOUDFLARE_*",
      "DATABASE_URL (owner shared database)"
    ]
  }
}
