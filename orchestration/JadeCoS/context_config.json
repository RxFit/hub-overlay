{
  "project_id": "jade-cos",
  "display_name": "Jade Chief of Staff",
  "is_internal_tool": true,
  "is_deployed": true,
  "is_client_facing": false,
  "is_enterprise": false,
  "status": "live",
  "port": 3919,
  "gcs_project": "Semantic-Brain-Desktop",
  "vertex_engine_id": "${VERTEX_ENGINE_ID_JADE_COS}",
  "github_bucket": "github-jade-cos",
  "github_repo": "RxFit/jade-cos",
  "data_sources": {
    "github": true,
    "analytics": false,
    "stripe": false,
    "cloud_sql": true
  },
  "connections": {
    "db_host": "${CLOUD_SQL_HOST}",
    "db_name": "antigravity_brain",
    "db_user": "${CLOUD_SQL_USER}",
    "db_port": 5432,
    "google_chat_webhook": "${GOOGLE_CHAT_WEBHOOK_URL}",
    "cloudflare_tunnel_token": "${CLOUDFLARE_TUNNEL_TOKEN}"
  },
  "volumes": {
    "rxfit_mcp": "ro",
    "cerberus_core": "ro",
    "jade_data": "rw"
  },
  "governance_gates": {
    "require_human_approval_for_external_comms": true,
    "require_human_approval_for_billing": true,
    "require_human_approval_for_db_schema_changes": true,
    "staging_only_billing": true,
    "cerberus_portability_mandate": true,
    "rxharden_financial_precision": true
  },
  "api_keys": {
    "github_token": "${GITHUB_TOKEN}"
  },
  "model_config": {
    "primary": "gemini-auto",
    "escalation": "antigravity",
    "escalation_triggers": ["db_schema_change", "security_severity_high", "financial_anomaly", "service_outage"]
  }
}
