{
  "project_id": "notebookrx",
  "display_name": "NotebookRx",
  "is_internal_tool": false,
  "is_enterprise": false,
  "is_experimental": true,
  "is_client_facing": true,
  "status": "experimental",
  "gcs_project": "Semantic-Brain-Desktop",
  "vertex_engine_id": "${VERTEX_ENGINE_ID_NOTEBOOKRX}",
  "github_bucket": "github-notebookrx",
  "github_repo": "RxFit/notebookrx",
  "data_sources": {
    "github": true,
    "analytics": true,
    "stripe": true,
    "cloud_sql": true
  },
  "connections": {
    "db_name": "antigravity_brain",
    "db_host": "${CLOUD_SQL_HOST}",
    "db_user": "${CLOUD_SQL_USER_NOTEBOOKRX}",
    "db_port": 5432
  },
  "governance_gates": {
    "require_human_approval_for_external_comms": true,
    "require_human_approval_for_billing": true,
    "require_human_approval_for_db_schema_changes": true,
    "staging_only_billing": true,
    "cerberus_portability_mandate": true,
    "rxharden_financial_precision": true,
    "health_data_sensitivity": true
  },
  "api_keys": {
    "stripe_api_key": "${STRIPE_API_KEY}",
    "ga_api_key": "${GA_API_KEY}",
    "github_token": "${GITHUB_TOKEN}",
    "llm_key": "${GEMINI_API_KEY}",
    "openai_fallback": "${OPENAI_API_KEY}"
  },
  "model_config": {
    "primary": "gemini-auto",
    "escalation": "antigravity",
    "escalation_triggers": ["db_schema_change", "health_data_privacy", "billing_change", "security_severity_high"]
  }
}
